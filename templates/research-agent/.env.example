# Copy this file to .env and fill in your values. Never commit .env to GitHub.

# Any OpenAI-compatible provider works. Examples:
#   OpenAI:                    https://api.openai.com/v1
#   Vultr Serverless Inference: https://api.vultrinference.com/v1
#   Groq:                      https://api.groq.com/openai/v1
#   Ollama (local):            http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# Exa web search. HackGlobal participants get $20 free Exa credits (link on Discord).
EXA_API_KEY=your-exa-key-here

# How many web results to read per question
NUM_RESULTS=5
